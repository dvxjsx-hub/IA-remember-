# Servidor
PORT=3000
NODE_ENV=production

# Login de la app (contraseña de 4 dígitos)
ACCESS_PASSWORD=1234

# Groq (obligatorio: sin esto la IA no responde)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (opcional: solo para memoria semántica sobre el chat)
OPENAI_API_KEY=your_openai_api_key_here
EMBEDDING_MODEL=text-embedding-3-small
